{
  "version": 2,
  "redirects": [
    { "source": "/api-test-redirect", "destination": "/api/ping", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|assets|favicon.ico|vite.svg).*)",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
